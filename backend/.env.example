# Application Environment (development, testing, production)
APP_ENV=development

# Application Metadata
PROJECT_NAME="PressLens API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/presslens

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Centralized Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Groq LLM API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# Embeddings & Vector Retrieval Configuration
# Default: BAAI/bge-small-en-v1.5 (384-dimensional dense vectors via fastembed ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30
