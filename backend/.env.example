# Application Environment (development, testing, production)
APP_ENV=development

# Application Metadata
PROJECT_NAME="PressLens API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/presslens

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
