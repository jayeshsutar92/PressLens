# ==============================================================================
# PressLens Deployment & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'testing', or 'production'
APP_ENV=production

# Application Metadata
PROJECT_NAME="PressLens API"
API_V1_STR="/api/v1"
LOG_LEVEL=INFO

# PostgreSQL Database URL
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Note: Cloud platforms providing standard postgres:// or postgresql:// are automatically
# adapted to postgresql+asyncpg:// at runtime.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/presslens

# CORS Configuration
# Comma-separated list or JSON array of allowed origins for frontend communication
# In production, replace with your frontend deployed domain(s), e.g. https://presslens.vercel.app
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Groq LLM API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# Embeddings & Vector Retrieval Configuration
# Default: BAAI/bge-small-en-v1.5 (384-dimensional dense vectors via fastembed ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30

# Port (injected automatically by cloud providers like Render, Heroku, Railway)
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend API v1 endpoints
# Local default: http://localhost:8000/api/v1 (or auto-detected 127.0.0.1:8000/api/v1)
# Production: Set to your deployed backend URL, e.g. https://presslens-api.onrender.com/api/v1
# If deploying frontend and backend on the same domain, leave unset to default to relative /api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

